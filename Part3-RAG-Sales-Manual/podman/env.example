# ============================================================================
# RAG Demo — Environment Variables
# Copy this file to .env and fill in values:  cp env.example .env
# The .env file is gitignored — never commit secrets.
# ============================================================================

# ── vLLM ──────────────────────────────────────────────────────────────────────
# IBM project-ai-services ppc64le vLLM CPU image
# https://github.com/IBM/project-ai-services/tree/main/ai-services/assets/components/llm/vllm-cpu
VLLM_IMAGE=ghcr.io/ibm/project-ai-services/vllm-cpu:latest

# HuggingFace model to load into vLLM.
# granite-3.3-8b-instruct is a good general-purpose choice for ppc64le CPU.
# Smaller option: ibm-granite/granite-3.3-2b-instruct
MODEL_ID=ibm-granite/granite-3.3-8b-instruct

# ── Pre-built images (set these if you push to a registry) ───────────────────
# Leave as localhost/... to use locally-built images (default).
RAG_BACKEND_IMAGE=localhost/rag-backend:latest
CARBON_UI_IMAGE=localhost/carbon-rag-ui:latest

# ── Watson Assistant (optional) ───────────────────────────────────────────────
# Leave empty to disable Watson Assistant integration.
WATSON_ASSISTANT_API_KEY=
WATSON_ASSISTANT_URL=
WATSON_ASSISTANT_ID=

# Made with Bob
